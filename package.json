{
    "name":  "dsh-agent-sentinel",
    "version":  "0.1.1",
    "description":  "哨兵插件（从 dsh-agent-watch 拆分）：监听哨兵文件（.hot-reload-flag）→ 触发时调用沙盒预检（ctx.preflight.run，消费 dsh-agent-preflight 服务）→ 通过才重启 web → 唤醒目标会话 → 清哨兵；预检失败则保留哨兵 + 落盘 incident + 通知（fail-closed，借鉴「编辑前需要阅读」——重启前必须预检）。",
    "type":  "module",
    "main":  "lib/index.js",
    "types":  "lib/types/index.d.ts",
    "exports":  {
                    ".":  {
                              "types":  "./lib/types/index.d.ts",
                              "default":  "./lib/index.js"
                          },
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "lib",
                  "README.md"
              ],
    "license":  "MIT",
    "peerDependencies":  {
                             "@deepseek-ai/cordis":  "^4.0.1",
                             "@deepseek-ai/schemastery":  "^3.18.1-rc.1",
                             "@deepseek-ai/dsh-tools":  "^0.1.0-rc.6"
                         },
    "devDependencies":  {
                            "@types/node":  "^22.0.0",
                            "typescript":  "^5.9.3"
                        },
    "scripts":  {
                    "build":  "tsc -p tsconfig.json",
                    "typecheck":  "tsc -p tsconfig.json --noEmit",
                    "test":  "node --test tests/"
                }
}
